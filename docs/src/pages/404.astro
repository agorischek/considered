---
import DocsLayout from "../layouts/DocsLayout.astro";
---

<DocsLayout title="Not found" description="This page does not exist." current="/404/" noindex>
  <article class="doc">
    <h1>Page not found</h1>
    <p>The page you were looking for is not part of the Considered docs.</p>
    <p><a href={import.meta.env.BASE_URL}>Return to the overview</a></p>
  </article>
</DocsLayout>
